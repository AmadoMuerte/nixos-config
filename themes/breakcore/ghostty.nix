{ colors }:

{
  "ghostty/theme-options" = ''
    # Generated by desktop.theme.
    font-family = Terminus
    font-family = DejaVu Sans Mono
    font-family = monospace
    font-size = 14
    background-opacity = 0.82
    background-blur = true
    cursor-style = block
    cursor-style-blink = false
    window-padding-x = 6
    window-padding-y = 6
  '';

  "ghostty/themes/desktop-theme" = ''
    # Generated by desktop.theme.
    palette = 0=${colors.background}
    palette = 1=${colors.error}
    palette = 2=#4de3a1
    palette = 3=${colors.warning}
    palette = 4=${colors.borderActive}
    palette = 5=${colors.accent}
    palette = 6=#00e5f0
    palette = 7=${colors.foreground}
    palette = 8=${colors.muted}
    palette = 9=#ff5cb8
    palette = 10=#7dffc4
    palette = 11=#ffe37a
    palette = 12=#5cebff
    palette = 13=#d98cff
    palette = 14=#00ffd5
    palette = 15=#ffffff
    background = ${colors.background}
    foreground = ${colors.foreground}
    cursor-color = ${colors.accent}
    cursor-text = ${colors.background}
    selection-background = ${colors.surface}
    selection-foreground = ${colors.foreground}
  '';
}
