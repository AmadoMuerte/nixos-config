{ colors }:

let
  # Ghostty reads each palette entry as ONE value, so the ANSI ramp is spelled
  # out entry by entry. Every value comes from colors.ansi in colors.nix --
  # change the palette there, never here.
  a = colors.ansi;
in

{
  "ghostty/theme-options" = ''
    # Generated by desktop.theme.
    font-family = JetBrainsMono Nerd Font
    font-family = Terminus
    font-family = monospace
    font-size = 14
    background-opacity = 0.92
    background-blur = true
    cursor-style = block
    cursor-style-blink = false
    window-padding-x = 6
    window-padding-y = 6
  '';

  "ghostty/themes/desktop-theme" = ''
    # Generated by desktop.theme. ANSI 0-15 from colors.ansi.
    palette = 0=${a.black}
    palette = 1=${a.red}
    palette = 2=${a.green}
    palette = 3=${a.yellow}
    palette = 4=${a.blue}
    palette = 5=${a.magenta}
    palette = 6=${a.cyan}
    palette = 7=${a.white}
    palette = 8=${a.brightBlack}
    palette = 9=${a.brightRed}
    palette = 10=${a.brightGreen}
    palette = 11=${a.brightYellow}
    palette = 12=${a.brightBlue}
    palette = 13=${a.brightMagenta}
    palette = 14=${a.brightCyan}
    palette = 15=${a.brightWhite}
    background = ${colors.background}
    foreground = ${colors.foreground}
    cursor-color = ${colors.accent}
    cursor-text = ${colors.background}
    selection-background = ${colors.surface}
    selection-foreground = ${colors.foreground}
  '';
}
