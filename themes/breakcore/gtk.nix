{ colors }:

let
  settings = ''
    [Settings]
    gtk-theme-name=adw-gtk3-dark
    gtk-application-prefer-dark-theme=1
    gtk-icon-theme-name=Papirus-Dark
    gtk-cursor-theme-name=Adwaita
    gtk-cursor-theme-size=24
    gtk-font-name=JetBrainsMono Nerd Font 10
  '';
  css = ''
    /* Generated by desktop.theme. Keep overrides conservative for libadwaita. */
    @define-color theme_bg_color ${colors.background};
    @define-color theme_base_color ${colors.surface};
    @define-color theme_fg_color ${colors.foreground};
    @define-color theme_text_color ${colors.foreground};
    @define-color theme_selected_bg_color ${colors.accent};
    @define-color theme_selected_fg_color ${colors.background};
    @define-color accent_bg_color ${colors.accent};
    @define-color accent_color ${colors.borderActive};
    @define-color accent_fg_color ${colors.background};
    @define-color destructive_bg_color ${colors.error};
    @define-color destructive_color ${colors.error};
    @define-color warning_bg_color ${colors.warning};
    @define-color warning_color ${colors.warning};

    /* Breakcore: muted plum accents on a rounded translucent shell.
       Radius scale: 14 large surface/popover, 10 card/input, 8 control. */
    tooltip, popover > contents, menu, .menu {
      background-color: alpha(${colors.surface}, 0.96);
      border: 1px solid ${colors.border};
      border-radius: 14px;
    }
    button, entry, spinbutton, dropdown > button {
      border: 1px solid ${colors.border};
      border-radius: 10px;
    }
    button:hover, entry:focus, entry:focus-within, spinbutton:focus, dropdown > button:hover {
      border-color: ${colors.borderActive};
      box-shadow: inset 0 0 0 1px ${colors.borderActive};
    }
    button:active, button:checked {
      background-color: ${colors.accent};
      color: ${colors.background};
      border-color: ${colors.borderActive};
    }
    selection { background-color: ${colors.accent}; color: ${colors.background}; }
    headerbar, .titlebar { border-radius: 14px 14px 0 0; }
    scrollbar slider { border-radius: 6px; background-color: ${colors.border}; }
    scrollbar slider:hover { background-color: ${colors.accent}; }
  '';
in
{
  "gtk-3.0/settings.ini" = settings;
  "gtk-4.0/settings.ini" = settings;
  "gtk-3.0/gtk.css" = css;
  "gtk-4.0/gtk.css" = css;
}
