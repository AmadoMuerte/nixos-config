{ colors }:

let
  hex = color: builtins.replaceStrings [ "#" ] [ "" ] color;
  rgba = color: alpha: "rgba(${hex color}${alpha})";
in
{
  "swaync/theme.css" = ''
    /* Generated by desktop.theme. */
    @define-color bg ${rgba colors.background "cc"};
    @define-color bg-alt ${rgba colors.panel "d9"};
    @define-color bg-hover ${rgba colors.surface "e6"};
    @define-color fg ${colors.foreground};
    @define-color fg-dim ${colors.muted};
    @define-color accent ${colors.accent};
    @define-color accent-alt ${colors.borderActive};
    @define-color warning ${colors.warning};
    @define-color critical ${colors.error};
    @define-color border ${colors.border};

    * {
        font-family: "Terminus", "Iosevka", monospace;
        font-size: 12px;
        border-radius: 12px;
        --notification-icon-size: 32px;
    }

    .notification-row { outline: none; }
    .notification-row:focus, .notification-row:hover { background: @bg-hover; }

    .notification {
        background: @bg-alt;
        color: @fg;
        border: 2px solid @accent;
        border-radius: 16px;
        margin: 6px 4px;
        padding: 8px 10px;
        box-shadow: 0 4px 24px 0 rgba(255, 42, 157, 0.35);
    }

    .notification.critical { border-color: @critical; }
    .notification.critical box-shadow: 0 4px 24px 0 rgba(255, 85, 102, 0.45);
    .notification-content { background: transparent; color: @fg; padding: 0; }
    .notification-content .image { margin-right: 8px; }
    .notification-content .summary { color: @accent; font-weight: bold; }
    .notification-content .body, .notification-content .time { color: @fg-dim; }

    .notification-action, .notification-default-action, .close-button {
        background: transparent;
        color: @accent-alt;
        border: 1px solid @border;
        border-radius: 8px;
        padding: 2px 6px;
        margin: 1px;
        min-height: 16px;
    }

    .notification-action:hover, .notification-default-action:hover, .close-button:hover {
        background: @accent;
        color: ${colors.background};
        border-color: @accent;
    }

    .control-center {
        background: @bg;
        border: 2px solid @accent-alt;
        border-radius: 18px;
        box-shadow: 0 8px 40px 0 rgba(0, 229, 240, 0.30);
    }

    .control-center-list { background: transparent; }
    .widget-title, .widget-dnd {
        color: @fg;
        background: @bg-alt;
        border: 1px solid @border;
        border-radius: 10px;
        margin: 4px;
        padding: 5px 8px;
    }
    .widget-title button, .widget-dnd > switch {
        color: @fg;
        background: @bg-hover;
        border: 1px solid @border;
        border-radius: 8px;
    }
    .widget-dnd > switch:checked { background: @accent; }
    .widget-dnd > switch slider { background: @fg; border-radius: 8px; }
    scrollbar slider { background: @accent; border-radius: 8px; min-width: 6px; min-height: 24px; }
  '';
}
