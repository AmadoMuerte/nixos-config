
{ colors }:

let
  # Midnight Violet palette — every value comes from colors.nix.
  # GTK3 wants rgba() with decimal channels — hex inside rgba() fails to
  # parse — so translucency goes through colors.rgb, solids through colors.*.
  ax = {
    hex = {
      background = colors.background;
      border = colors.border;
      foreground = colors.foreground;
      muted = colors.muted;
      accent = colors.accent;
      error = colors.error;
    };
    rgb = colors.rgb;
  };
in
{
  "swaync/theme.css" = ''
    /* Generated by desktop.theme. Midnight Violet popup: a floating near-black
       card with a large radius, a lavender icon tile, pale text, and a round
       coral-red close button. No global * rule: the font is set once on the
       top-level windows (and the two roots, as insurance) and inherits from there. */
    @define-color surface rgba(${ax.rgb.background}, 0.95);
    @define-color panel rgba(${ax.rgb.background}, 0.95);
    @define-color hover rgba(${ax.rgb.border}, 0.25);
    @define-color hairline rgba(${ax.rgb.border}, 0.40);
    @define-color fg ${ax.hex.foreground};
    @define-color fg-dim ${ax.hex.muted};
    @define-color accent ${ax.hex.accent};
    @define-color critical ${ax.hex.error};

    window, .notification, .control-center {
        font-family: "JetBrainsMono Nerd Font", monospace;
        font-size: 13px;
    }

    .notification-row { outline: none; }
    .notification-row:hover .notification,
    .notification-row:focus .notification { background: @hover; }

    /* The card: big radius, roomy padding, one hairline. */
    .notification {
        background: @surface;
        color: @fg;
        border: 1px solid @hairline;
        border-radius: 16px;
        margin: 8px 10px;
        padding: 12px 14px;
        box-shadow: 0 4px 16px 0 rgba(0, 0, 0, 0.45);
    }

    /* The one loud edge: a 2px red strip, criticals only. */
    .notification.critical {
        border-left: 2px solid @critical;
        box-shadow: 0 4px 16px 0 rgba(${ax.rgb.error}, 0.25);
    }

    .notification-content {
        background: transparent;
        color: @fg;
        padding: 0;
        --notification-icon-size: 32px;
    }

    /* Lavender wash behind the app glyph. */
    .notification-content .image {
        background: rgba(${ax.rgb.accent}, 0.17);
        border-radius: 10px;
        padding: 6px;
        margin-right: 12px;
    }

    .notification-content .summary { color: @fg; font-weight: bold; }
    .notification-content .body, .notification-content .time { color: @fg-dim; }

    /* The whole card is the click target; it must not draw a frame of its own. */
    .notification-default-action {
        background: transparent;
        border: none;
        padding: 0;
        margin: 0;
    }

    .notification-action {
        background: transparent;
        color: @fg-dim;
        border: 1px solid @hairline;
        border-radius: 10px;
        padding: 5px 12px;
        margin: 8px 2px 2px 2px;
        min-height: 16px;
    }

    .notification-action:hover { background: @hover; color: @fg; }

    /* Round close button, coral-red on hover. */
    .close-button {
        background: transparent;
        color: @fg-dim;
        border: none;
        border-radius: 9999px;
        margin: 4px;
        padding: 2px;
        min-height: 22px;
        min-width: 22px;
    }

    .close-button:hover {
        background: rgba(${ax.rgb.error}, 0.20);
        color: @critical;
    }

    .control-center {
        background: @panel;
        border: 1px solid @hairline;
        border-radius: 16px;
        box-shadow: 0 4px 18px 0 rgba(0, 0, 0, 0.40);
    }

    .control-center-list { background: transparent; }

    .widget-title, .widget-dnd {
        color: @fg;
        background: rgba(${ax.rgb.border}, 0.17);
        border: 1px solid @hairline;
        border-radius: 12px;
        margin: 8px 10px;
        padding: 10px 12px;
    }

    .widget-title > button {
        color: @fg-dim;
        background: transparent;
        border: 1px solid @hairline;
        border-radius: 10px;
        padding: 2px 10px;
    }

    .widget-title > button:hover { background: @hover; color: @fg; }

    /* The DND switch in its on state uses the lavender accent. */
    .widget-dnd > switch {
        background: rgba(${ax.rgb.border}, 0.80);
        border-radius: 9999px;
    }

    .widget-dnd > switch:checked { background: @accent; }

    .widget-dnd > switch slider {
        background: @fg;
        border-radius: 9999px;
    }

    .widget-dnd > switch:checked slider { background: ${ax.hex.background}; }

    scrollbar slider {
        background: rgba(${ax.rgb.muted}, 0.50);
        border-radius: 6px;
        min-width: 6px;
        min-height: 24px;
    }
  '';
}
