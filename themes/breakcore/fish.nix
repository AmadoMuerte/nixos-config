{ colors }:

{
  "fish/conf.d/desktop-theme.fish" = ''
    # Generated by desktop.theme.
    # Palette contrast on the background: accent, foreground and borderActive
    # are all far above the 4.5:1 read-text floor and pairwise distinct.
    function fish_prompt
        set_color ${builtins.replaceStrings [ "#" ] [ "" ] colors.accent}
        printf '%s@%s ' $USER (prompt_hostname)
        set_color ${builtins.replaceStrings [ "#" ] [ "" ] colors.foreground}
        printf '%s' (prompt_pwd)
        set_color ${builtins.replaceStrings [ "#" ] [ "" ] colors.borderActive}
        printf ' %% '
        set_color normal
    end
  '';
}
