{ colors }:

let
  # breakcore/colors.nix carries hex tokens; GTK CSS wants alpha, so the
  # "R,G,B" triples living in colors.rgb feed every rgba() here.
  c = colors.rgb;
in
{
  "waybar/theme.css" = ''
    /* Generated by desktop.theme. */
    @define-color bg rgba(${c.panel}, 0.72);
    @define-color bg-alt rgba(${c.surface}, 0.92);
    @define-color bg-hover rgba(${c.borderActive}, 0.18);
    @define-color fg ${colors.foreground};
    @define-color fg-dim ${colors.muted};
    @define-color accent ${colors.accent};
    @define-color accent-dim ${colors.accentDim};
    @define-color warning ${colors.warning};
    @define-color critical ${colors.error};
    @define-color border rgba(${c.border}, 0.85);
    @define-color border-active ${colors.borderActive};

    * {
        font-family: "Terminus", "Iosevka", monospace;
        font-size: 14px;
        border: none;
        border-radius: 0;
        min-height: 0;
    }

    window#waybar {
        background: @bg;
        color: @fg;
        border: 1px solid @border;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(${c.background}, 0.55),
                    inset 0 0 0 1px rgba(${c.accent}, 0.22);
        min-height: 25px;
    }

    tooltip {
        background: @bg-alt;
        color: @fg;
        border: 1px solid @border;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(${c.background}, 0.65);
    }

    #workspaces {
        padding: 0 3px;
        margin: 3px 0;
        border-right: 1px solid @border;
    }

    #workspaces button {
        background: transparent;
        color: @fg-dim;
        padding: 0 8px;
        margin: 0 1px;
        border-radius: 10px;
        border-left: 1px solid transparent;
        border-right: 1px solid transparent;
    }

    #workspaces button.active {
        background: @bg-hover;
        color: @accent;
        border-left-color: @accent;
        border-right-color: @accent;
    }

    #workspaces button:hover {
        background: @bg-alt;
        color: @fg;
    }

    #workspaces button.urgent,
    #custom-ai-quota.critical,
    #custom-ai-quota.error {
        background: rgba(${c.borderActive}, 0.16);
        color: @border-active;
    }

    #memory.critical,
    #network.disconnected,
    #temperature.critical {
        color: @critical;
    }

    #custom-host,
    #custom-ai-quota,
    #custom-system-load,
    #custom-opencode-remote,
    #cpu, #memory, #temperature, #network, #bluetooth, #pulseaudio,
    #custom-kb_layout, #tray, #custom-notification, #clock {
        color: @fg;
        padding: 0 7px;
    }

    #custom-host { color: @accent; }
    #custom-ai-quota, #custom-kb_layout, #custom-notification { color: @fg-dim; }
    #custom-ai-quota { border-right: 1px solid @border; }
    #custom-system-load { border-left: 1px solid @border; }
    #cpu, #network, #pulseaudio, #clock { border-left: 1px solid @border; }
    #memory.warning, #custom-ai-quota.warning { color: @warning; }
    #pulseaudio.muted { color: @fg-dim; }
    #tray { padding-right: 4px; }
    #tray > widget { margin: 0 2px; }
    #tray > .passive { -gtk-icon-effect: dim; }
    #tray > .needs-attention { -gtk-icon-effect: highlight; }
  '';
}
